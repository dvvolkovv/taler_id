# Database
DATABASE_URL=postgresql://user:password@localhost:5432/taler_id

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Application
PORT=3000
BASE_URL=https://id.taler.tirol
NODE_ENV=production

# SMTP (email)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=taler-documents
S3_REGION=us-east-1

# KYC (mock_ss — SumSub-compatible WebSDK wire contract)
SUMSUB_BASE_URL=https://mockss-test.up.railway.app
SUMSUB_LEVEL_NAME=trientes-kyc-level
SUMSUB_TTL_SECS=600
# Optional — if mock signs webhooks with HMAC-SHA256(x-payload-digest)
SUMSUB_WEBHOOK_SECRET=

# Blockchain
BLOCKCHAIN_ENABLED=false
TALER_NODE_WS=wss://node.dev.gsmsoft.eu/
# Taler chain node WebSocket endpoint (used by DepositWatcher when BLOCKCHAIN_ENABLED=true)
BLOCKCHAIN_NODE_URL=wss://node.dev.gsmsoft.eu/
KYC_CONTRACT_ADDRESS=
ATTESTER_MNEMONIC=your-substrate-mnemonic

# --- TAL Billing ---
# WARNING: Rotating WALLET_ENCRYPTION_KEY orphans every existing custodial wallet.
# Rotation requires a DB migration that re-encrypts all UserWallet.custodialKeyEnc
# rows with the new key. Do NOT rotate in production without that migration.
# Must be ≥32 characters.
WALLET_ENCRYPTION_KEY=change_me_32_bytes_min_for_aes256gcm_derivation

# Shared secret for agent → /metering/report callbacks (ai-twin-agent, outbound-call-agent).
METERING_SHARED_SECRET=change_me_long_random_hex

# Secret for /voice/ai-twin/callback (ai-twin-agent → backend). Distinct from
# METERING_SHARED_SECRET because ai-twin was deployed with its own contract
# earlier. Must be set on both backend and agent .env.
AI_TWIN_CALLBACK_SECRET=change_me_long_random_hex

# Secret for /outbound-bot/call-callback (outbound-call-agent → backend).
# Same contract as above. Must be set on both.
OUTBOUND_CALLBACK_SECRET=change_me_long_random_hex

# Secret for recorder → backend calls (/voice/meetings/save, /voice/recordings/upload).
# Sent as x-recorder-secret header by livekit-ai-agent recorder.js (DEV box + DO box).
# Must be set on backend and on each recorder's .env.
RECORDER_SHARED_SECRET=change_me_long_random_hex

# ── Informer bot (optional — disables the bot if KEY or SECRET is blank) ───────
# GsmSoft Informer API (HMAC-SHA256 signed read-only endpoints). See
# /informer/v1/* — wallet/balance monitoring restricted to 4 ops users.
INFORMER_API_BASE_URL=https://apiadmin.test.gsmsoft.eu
INFORMER_API_KEY=
INFORMER_API_SECRET=
INFORMER_POLL_INTERVAL_MS=300000
INFORMER_WATCHER_ENABLED=true
# Dev/test only — exposes POST /informer-bot/debug/tick for e2e tests:
INFORMER_DEBUG_TICK=false

# Voice owner gating (experimental, see docs/superpowers/specs/2026-06-08-voice-owner-gating-design.md)
# Local ECAPA sidecar (voice-embed-service PM2 process on DEV)
VOICE_EMBED_URL=http://127.0.0.1:18082
OWNER_VOICE_THRESHOLD=0.3
OWNER_VOICE_WINDOW_MS=3000
OWNER_VOICE_ENABLED=true

# Mail hosting (@talerid.io mailboxes via Mailcow)
MAILCOW_API_URL=https://mail.selyanska.eu
MAILCOW_API_KEY=changeme
MAIL_DOMAIN=mail-dev.taler.tirol
MAIL_CLIENT_HOST=mail.talerid.io
MAIL_MASTER_KEY=changeme_64_hex_chars
MAIL_SEND_DAILY_LIMIT=50

# LiveKit (voice/video SFU). Required — the backend refuses to start without
# them. These sign every room access token and authenticate the admin
# RoomServiceClient, so treat them like a password: anyone holding the secret
# can mint a token for any room.
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme

# Confidential OAuth client secrets. Leave unset to use the secret stored on
# the OAuthClient row; set to override it from the environment.
WALLETX_CLIENT_SECRET=
LINKEON_PARTNER_CLIENT_SECRET=

# Stub top-ups credit balance without taking payment. DEV/TEST only — never
# set this in production.
BILLING_STUB_PURCHASE_ENABLED=false

# Trusted proxy hops for Express (req.ip / rate limiting). Default: loopback.
TRUST_PROXY=loopback

# Allow-listed OpenAI realtime models for /voice/realtime-proxy (comma separated).
REALTIME_ALLOWED_MODELS=gpt-realtime-mini-2025-12-15

# Clients allowed to manage OAuth clients and account via /oauth/clients,
# /oauth/register and /oauth/account (comma separated). Default: the
# Developer Portal only.
OAUTH_MANAGEMENT_CLIENTS=taler-id-developers

# Ceiling for chunked uploads via /messenger/files/init (bytes). Default 512MB.
MESSENGER_MAX_UPLOAD_BYTES=536870912
